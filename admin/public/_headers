# Cloudflare Pages security headers for admin.website.lk
# connect-src / img-src list the API and media domains — update them if the domain changes.
/*
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https://media.website.lk; connect-src 'self' https://api.website.lk; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
