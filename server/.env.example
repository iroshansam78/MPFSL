# Copy to .env for local development. Never commit the real .env.
# On Railway, set these in the service's Variables tab instead.

NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Your local MongoDB (standalone is fine for development), or an Atlas *dev* cluster
# (mongodb+srv://user:pass@cluster.../mpfsl-dev). Production must be a replica set (Atlas).
# Only add ?replicaSet=... if your MongoDB really is a replica set (e.g. `npm run dev:db`, port 27018).
MONGODB_URI=mongodb://127.0.0.1:27017/mpfsl-dev

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string-of-48-plus-chars
SESSION_TTL_HOURS=8
SESSION_REMEMBER_DAYS=14

# Browser origins allowed to call the API
ADMIN_ORIGIN=http://admin.localhost:5180
PUBLIC_ORIGINS=http://localhost:5180

LOGIN_RATE_LIMIT=10

# Cloudflare R2 - where uploaded photos are stored.
# Leave any of these empty in development and photos are saved in server/.data/uploads instead.
# In production, photo uploads are turned off until all five are set. The account id is the first part of the S3 API URL
# (https://<account id>.r2.cloudflarestorage.com). MEDIA_BASE_URL is the bucket's public URL,
# e.g. https://media.mpfsl.lk (custom domain) or https://pub-xxxx.r2.dev
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mpfsl-media-dev
MEDIA_BASE_URL=
