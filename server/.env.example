# Copy to .env for local development. Never commit the real .env.
# On Railway, set these in the service's Variables tab instead.

NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Local MongoDB, or your Atlas *dev* cluster (mongodb+srv://user:pass@cluster.../mpfsl-dev)
# Note: transactions (used when editing users, featuring stories) need a replica set — Atlas always
# is one; for a local mongod start it with --replSet rs0 and run rs.initiate() once.
MONGODB_URI=mongodb://127.0.0.1:27017/mpfsl-dev?replicaSet=rs0

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string-of-48-plus-chars
SESSION_TTL_HOURS=8
SESSION_REMEMBER_DAYS=14

# Browser origins allowed to call the API
ADMIN_ORIGIN=http://admin.localhost:5180
PUBLIC_ORIGINS=http://localhost:5180

LOGIN_RATE_LIMIT=10

# Cloudflare R2 (needed from the media phase onwards)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mpfsl-media-dev
MEDIA_BASE_URL=
