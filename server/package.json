{
  "name": "@mpfsl/server",
  "version": "0.1.0",
  "private": true,
  "description": "MPFSL API — news, gallery and admin accounts",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev:db": "node scripts/dev-db.js",
    "init": "node --env-file-if-exists=.env scripts/init.js",
    "dev": "node --watch --env-file=.env src/index.js",
    "start": "node src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "reset-password": "node --env-file-if-exists=.env scripts/reset-password.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@mpfsl/shared": "^0.1.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.4"
  },
  "config": {
    "mongodbMemoryServer": {
      "downloadDir": "../node_modules/.cache/mongodb-memory-server"
    }
  }
}
